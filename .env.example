# Relay Application Configuration
# Copy this file to .env and fill in the values

# Flask Environment
# Options: development, production, testing
FLASK_ENV=development

# Debug mode - set to '1' for development, '0' for production
FLASK_DEBUG=1

# Server Configuration
# 127.0.0.1 = this machine only; 0.0.0.0 = serve on the network (requires TLS)
HOST=127.0.0.1
PORT=5000

# TLS (HTTPS). A self-signed certificate is generated on first run in
# instance/tls/ and pinned by clients. Plain HTTP (0) is loopback-only.
TLS_ENABLED=1
# TLS_CERT_FILE=instance/tls/cert.pem
# TLS_KEY_FILE=instance/tls/key.pem
# Extra names/IPs for a newly generated certificate, e.g. your LAN IP
TLS_EXTRA_HOSTNAMES=

# JWT Configuration
# REQUIRED in production - generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256

# Database Configuration
# For SQLite: sqlite:///secure_exchange.db
# For PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///secure_exchange.db

# Security
# Set to 'https' in production with TLS
PREFERRED_URL_SCHEME=http

# Message retention
# Days before stored ciphertext expires; 0 disables expiry (applies to new messages)
MESSAGE_TTL_DAYS=30
# Maximum stored messages per recipient; 0 disables the cap
MAX_INBOX_MESSAGES=1000
